# Ovoz serveri (LiveKit). Bo'sh qoldirilsa ovoz o'chiq, qolgan hammasi ishlaydi.
# Mahalliy sinov: livekit-server --dev  (kalitlari: devkey / secret)
# LiveKit Cloud: loyiha sozlamalaridagi URL (wss://....livekit.cloud) va API key/secret
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
